# Local Docker: http://localhost:3000. Public deployment: HTTPS origin of the proxy.
POSTGRES_DB=fsc
POSTGRES_USER=fsc
POSTGRES_PASSWORD=replace-with-random-password
# Direct development only; Docker uses its internal db:5432 service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
APP_PORT=3000
BETTER_AUTH_URL=https://calendar.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Required for verification, invitations, reset and e-mail reminders.
# Compose mailpit profile: SMTP_HOST=mailpit SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FSC <fsc@example.com>

# Billets joints aux événements. Docker : volume `uploads` monté sur /data/uploads.
UPLOAD_DIR=./uploads

# Generate once with: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
