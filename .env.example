# Copy to .env and replace POSTGRES_PASSWORD before starting Docker Compose.
# Use a URL-safe password (for example: openssl rand -hex 32).
POSTGRES_DB=fsc
POSTGRES_USER=fsc
POSTGRES_PASSWORD=replace-with-a-random-password
APP_PORT=3000

# Only used by direct local development (bun run dev / bun run migrate).
# Docker Compose constructs its own URL using the db service hostname above.
# For an external PostgreSQL >= 15 database, supply its actual connection URL.
DATABASE_URL="postgresql://fsc:replace-with-a-random-password@localhost:5432/fsc"
