# Docker: public HTTPS origin of the reverse proxy in front of FSC.
POSTGRES_DB=fsc
POSTGRES_USER=fsc
POSTGRES_PASSWORD=replace-with-url-safe-random-password
APP_BIND=127.0.0.1
APP_PORT=3000
BETTER_AUTH_URL=https://calendar.example.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Direct development: reachable PostgreSQL database; use an HTTP auth URL locally.
DATABASE_URL=postgresql://fsc:replace-with-url-safe-random-password@localhost:5432/fsc

# Required for verification, invitations, reset and e-mail reminders.
# Compose mailpit profile: SMTP_HOST=mailpit SMTP_PORT=1025
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FSC <fsc@example.com>

# Generate once with: bunx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
