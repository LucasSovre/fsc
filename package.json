{
  "name": "fsc",
  "version": "0.1.0",
  "private": true,
  "license": "WTFPL",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "build": "next build",
    "auth:contract": "bun scripts/auth-contract.ts",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "db:update": "prisma db update",
    "db:verify": "prisma db verify",
    "dev": "next dev --webpack",
    "account:create": "node --env-file=.env --import tsx scripts/create-account.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:health": "tsx scripts/worker-health.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit.test.ts",
    "test:integration": "bun test tests/integration.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint",
    "migrate": "prisma db migrate",
    "migration:plan": "prisma migration plan",
    "migration:show": "prisma migration show",
    "migration:status": "prisma migration status",
    "skills:sync": "prisma skills sync || exit 0",
    "start": "next start",
    "postinstall": "prisma skills sync || exit 0"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.18",
    "@better-auth/oauth-provider": "1.7.18",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "better-auth": "1.7.18",
    "ical-generator": "11.1.3",
    "ical.js": "^2.2.1",
    "motion": "^14.10.1",
    "next": "16.4.2",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "temporal-polyfill": "^1.0.6",
    "web-push": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "prisma": "8.0.0-rc.33",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "effect": "4.0.5",
    "@effect/platform-bun": "4.0.5",
