  "dependencies": {
    "@prisma/composer": "0.38.0",
    "@prisma/composer-prisma-cloud": "0.38.0",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "alchemy": "2.0.0-beta.84",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "temporal-polyfill": "^1.0.6"
  },
  "devDependencies": {
    "@prisma/dev": "0.25.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "prisma": "8.0.0-rc.33",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "effect": "4.0.5",
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/platform-node-shared": "4.0.5",
    "@effect/vitest": "4.0.5"
  }
